[Unit]
Description=JARVIS Continuous Operations
After=network.target postgresql@14-main.service jarvis-api.service jarvis-telegram.service
Wants=postgresql@14-main.service jarvis-api.service jarvis-telegram.service

[Service]
Type=simple
User=jarvis-ops
Group=jarvis-ops
WorkingDirectory=/srv/jarvis/current
EnvironmentFile=/srv/jarvis/shared/.env
ExecStart=/usr/bin/node operations-loop.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillMode=mixed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/jarvis

[Install]
WantedBy=multi-user.target
